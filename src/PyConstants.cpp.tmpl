            {% if define.comment|length > 3 %}
                {# A blank line below for visual separation #}

            {% endif%}
    {{- define.comment|join('\n')|indent(4, first=True) }}
        {% endif %}
        {% if define.value.startswith("'") and define.value.endswith("'") and define.value | length == 3 %}
    if( PyModule_AddCharMacro(m, {{ define.name }}) < 0 ) return -1;
        {% elif define.value.startswith("'") and define.value.endswith("'") and define.value | length > 3 %}
