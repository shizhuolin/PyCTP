        {% if enum.comment %}
    {{- enum.comment|join('\n')|indent(4, first=True) }}
        {% endif %}
        {% for member in enum.members %}
            {% if member.comment %}
    {{- member.comment|join('\n')|indent(4, first=True) }}
            {% endif %}
    if( PyModule_AddIntMacro(m, {{ member.name }}) < 0 ) return -1;
        {% endfor %}
    {% else %}
        {{ enum }}
    {% endif %}
{% endfor %}

{% for define in defines %}
